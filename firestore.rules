rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // PII protection, no listing user accounts
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // Assessments subcollection
      match /assessments/{assessmentId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(assessmentId);
        allow update: if isOwner(userId) && isValidId(assessmentId);
        allow delete: if isOwner(userId);
      }

      // Saved Resources subcollection
      match /savedResources/{resourceId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(resourceId);
        allow update: if isOwner(userId) && isValidId(resourceId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
